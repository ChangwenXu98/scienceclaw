# Phonon calculation for YH6
structure_file = relaxed/YH6/CONTCAR
output_dir = phonons/YH6

# Phonon settings
calc_type = phonon
supercell = 2 2 2
displacement = 0.01  # Angstrom
q_points_density = 0.2

# Electronic structure (same as relaxation)
xc_functional = PBE
k_points_density = 0.3
energy_cutoff = 800
smearing = 0.1

# Analysis
compute_dos = true
compute_thermal_properties = true
temperature_range = 0 300 10  # K
